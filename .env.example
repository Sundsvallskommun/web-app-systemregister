COMPOSE_PROJECT_NAME=systemregister
NODE_ENV=development

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Backend (BFF) — proxy mot api-service-systemregister
API_BASE_URL=http://host.docker.internal:8080
MUNICIPALITY_ID=2281
BASE_URL_PREFIX=/api
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
ORIGIN=http://localhost:3000
CREDENTIALS=true
LOG_FORMAT=dev
SWAGGER_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================================
# Tillägg som används med docker-compose.api-service.yml
# (api-service-systemregister + MariaDB som extra containers)
# ============================================================
API_SERVICE_PORT=8080
# Spring-profil för api-service (lämna tom för default)
SPRING_PROFILES_ACTIVE=

# MariaDB
MARIADB_DATABASE=systemregister
MARIADB_USER=systemreg
MARIADB_PASSWORD=change-me-systemreg
MARIADB_ROOT_PASSWORD=change-me-root
# Avkommentera + sätt port om du vill exponera DB på host (för DBeaver osv)
# MARIADB_PORT=3306
