APP_NAME=Systemregistret BFF
NODE_ENV=development
PORT=3001
BASE_URL_PREFIX=/api

# Java api-service-systemregister
API_BASE_URL=http://localhost:8080
MUNICIPALITY_ID=2281

# Session
SECRET_KEY=dev-only-change-me-to-a-long-random-string
SESSION_TTL=28800
SESSION_STORE=memory

# SAML / SSO
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_SUCCESS_REDIRECT=http://localhost:3000/dashboard
SAML_FAILURE_REDIRECT=http://localhost:3000/
SAML_LOGOUT_REDIRECT=http://localhost:3000/
SAML_ENTRY_SSO=http://172.16.124.2/idp2/api/saml/idp/sso
SAML_LOGOUT_URL=
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_KEY}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_KEY}}\n-----END CERTIFICATE-----\n"
SAML_ISSUER=passport-saml

# AD-grupper som ger behörighetsnivå
ADMIN_GROUP=""
EDITOR_GROUP=""
VIEWER_GROUP=""

# CORS — frontend origin(s), comma-separated
ORIGIN=http://localhost:3000
CREDENTIALS=true

# Logging
LOG_FORMAT=dev
LOG_DIR=../data/logs

# Swagger (BFF eget OpenAPI-doc, separat från api-service)
SWAGGER_ENABLED=true

# Rate limit (för SAML-callbacken)
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=10